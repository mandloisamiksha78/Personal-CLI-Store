}
.hr-flex1 p {
  margin: 0;
  color: #00000036;
}
.hr-flex2 p {
  margin: 0;
  color: #00000036;
}
.hr-row {
  background-color: #ffffff;
  border-top: 1px solid #00000036;
  padding: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: gray;
  font-size: 12px;
  font-weight: 700;
}
s {
  margin-left: 15px;
  color: gray;
}
.head-left a {
    text-decoration: none;
}
.head-right a {
    text-decoration: none;
}
.hr-flex2 a {
    text-decoration: none;
}
  
