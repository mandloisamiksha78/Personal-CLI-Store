  font-weight: 700;
  line-height: 11px;
  text-align: left;
  color: gray;
}
.descrb h5 {
  font-size: 14px;
  font-weight: 700;
  line-height: 20px;
  text-align: left;
}
.descrb h4 {
  margin: 0;
  color: #000000;
  font-weight: 700;
}
.timer {
  width: 100%;
  max-width: 60%;
  display: flex;
  justify-content: space-around;
}
.box .key {
  margin: 0;
}
p.value {
  font-size: 11px;
  font-weight: 700;
  line-height: 11px;
